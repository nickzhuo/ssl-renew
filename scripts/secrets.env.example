# =============================================================================
#  DNS 服务商 API 凭据   scripts/secrets.env
# -----------------------------------------------------------------------------
#  ★ 这个文件只放 DNS 服务商的 API 凭据，不放任何别的东西
#    （域名在 domains.conf，策略在 ssl.conf）。
#  ★ 它已被 .gitignore 排除，永远不会被提交到仓库。
#  ★ 权限必须是 600：chmod 600 scripts/secrets.env
#
#  ★ 支持多个服务商 × 每个服务商多个账号：
#      账号名 default  ->  变量名**不带后缀**
#      账号名 <名字>   ->  变量名带 _<名字> 后缀（只能用字母 / 数字 / 下划线）
#    domains.conf 里用 dns=<服务商> account=<账号名> 指定，不写就是
#    dns=tencent、account=default。
# =============================================================================


# =============================================================================
# 一、腾讯云 DNSPod（域名解析托管在腾讯云时用）
# =============================================================================
#  怎么拿密钥
#    腾讯云控制台 → 访问管理(CAM) → API 密钥管理 → 新建密钥
#        https://console.cloud.tencent.com/cam/capi
#    安全建议（强烈推荐）：不要用主账号密钥。在每个账号下各建一个子账号
#    （例如 ssl-bot），只授予 DNS 解析权限策略 QcloudDNSPodFullAccess。
#    这样即使密钥泄露，攻击面也仅限于域名解析。
#
#  ⚠️ 要用 CAM 的 API 密钥（AKID... 开头），不是 DNSPod 旧版 Token。
# -----------------------------------------------------------------------------

# 账号 default —— domains.conf 里没写 dns= / account= 的证书都走这组。
# 只有一个腾讯云账号的话，填这两行就够了。
Tencent_SecretId=""
Tencent_SecretKey=""

# 其它腾讯云账号（可选）。后缀就是 domains.conf 里的 account= 名字：
#     shop.com *.shop.com | account=ACC2
# Tencent_SecretId_ACC2=""
# Tencent_SecretKey_ACC2=""


# =============================================================================
# 二、GoDaddy（域名解析托管在 GoDaddy 时用）
# =============================================================================
#  怎么拿密钥
#    GoDaddy → 我的账户 → API 密钥（Developer Portal）
#        https://developer.godaddy.com/keys
#
#  ★ 必须创建 **Production（生产）** Key / Secret。
#    acme.sh 的 dns_gd 钩子只会去打 https://api.godaddy.com/v1，
#    OTE（测试环境）的密钥在这里无效，会报认证失败。
#
#  ★ 变量名 GD_Key / GD_Secret 是 acme.sh 钩子里**硬编码**读的名字，
#    不能改（多账号时也只是加后缀）。
#
#  ★ 前提：那个域名的 **NS 必须真的指向 GoDaddy**（形如 nsXX.domaincontrol.com）。
#    「在 GoDaddy 注册」≠「解析托管在 GoDaddy」—— 后者指 NS 记录，
#    可以在 GoDaddy 账户里改。NS 不在 GoDaddy，TXT 记录就写不进去。
#    先确认：dig +short NS <你的域名>
#
#  ⚠️ GoDaddy 的 API 有频率限制，批量签发时把 ssl.conf 的 SSL_DNS_SLEEP 调大些
#     （acme.sh 的 dns_gd 钩子内部本身还会再 sleep 10 秒）。
# -----------------------------------------------------------------------------

# 账号 default
GD_Key=""
GD_Secret=""

# 其它 GoDaddy 账号（可选）。后缀就是 domains.conf 里的 account= 名字：
#     shop.com *.shop.com | dns=godaddy account=GD2
# GD_Key_GD2=""
# GD_Secret_GD2=""


# =============================================================================
#  ★ 一张证书（domains.conf 里的一行）里的所有域名
#    必须同属「同一个服务商 + 同一个账号」
# -----------------------------------------------------------------------------
#  DNS-01 验证是一次调用写完整行的 TXT 记录，acme.sh 一次只能用一套凭据。
#  域名跨服务商 / 跨账号时必须拆成两行：
#
#      api.example.com      | dns=tencent account=ACC2     # 解析在腾讯云账号 ACC2 下
#      shop.com *.shop.com  | dns=godaddy account=GD2     # 解析在 GoDaddy 账号 GD2 下
#      www.example.com                                    # 不写 = tencent / default
# =============================================================================


# -----------------------------------------------------------------------------
#  填好后自检
# -----------------------------------------------------------------------------
#      ./ssl-status.sh                # 看每个域名归属哪个服务商/账号、文件是否齐备
#      ./ssl-issue.sh --check-only     # 先看会做什么，不改动任何东西
# =============================================================================
